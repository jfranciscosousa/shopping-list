{
  "name": "shopping-list",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm dlx vercel env pull .env && next dev",
    "build": "prisma generate && prisma db push && next build",
    "build:ci": "prisma generate && next build",
    "start": "next start",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
